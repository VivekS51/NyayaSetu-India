{
  "name": "nyayasetu-india-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Incentive-Based eMarketplace for Legal Service Providers in India",
  "scripts": {
    "dev:backend": "pnpm --filter @legal-marketplace/backend run dev",
    "dev:frontend": "pnpm --filter @legal-marketplace/frontend run dev",
    "build:backend": "pnpm --filter @legal-marketplace/backend run build",
    "build:frontend": "pnpm --filter @legal-marketplace/frontend run build",
    "build": "pnpm build:backend && pnpm build:frontend",
    "start:backend": "pnpm --filter @legal-marketplace/backend start",
    "start:frontend": "pnpm --filter @legal-marketplace/frontend start",
    "start": "pnpm start:backend",
    "db:generate": "pnpm --filter @legal-marketplace/backend prisma:generate && pnpm --filter @legal-marketplace/frontend prisma:generate",
    "db:push": "pnpm --filter @legal-marketplace/backend prisma:db:push",
    "db:migrate": "pnpm --filter @legal-marketplace/backend prisma:migrate:deploy",
    "db:seed": "pnpm --filter @legal-marketplace/backend seed",
    "postinstall": "pnpm db:generate",
    "test": "pnpm --filter @legal-marketplace/backend run test:all",
    "test:unit": "pnpm --filter @legal-marketplace/backend run test:unit",
    "test:api": "pnpm --filter @legal-marketplace/backend run test:api",
    "test:security": "pnpm --filter @legal-marketplace/backend run test:security",
    "test:coverage": "pnpm --filter @legal-marketplace/backend run test:coverage",
    "test:e2e": "playwright test"
  }
}
